{
  "name": "yumi-personal-site",
  "version": "0.1.0",
  "private": true,
  "description": "yumi / cl personal site — AI, automation and desktop tools.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.static.config.ts --configLoader runner",
    "build": "vite build --config vite.static.config.ts --configLoader runner",
    "start": "npm run preview",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && node --test tests/static-build.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "type": "module"
}
